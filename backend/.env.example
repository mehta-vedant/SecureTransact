# Backend configuration — copy to `.env` (never commit the real one)

# PostgreSQL (local or Neon). For Neon use the UNPOOLED endpoint with sslmode=require:
# SPRING_DATASOURCE_URL=jdbc:postgresql://<host>.neon.tech/neondb?sslmode=require
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/securetransact
SPRING_DATASOURCE_USERNAME=postgres
SPRING_DATASOURCE_PASSWORD=change-me

# JWT — REQUIRED, no default. Generate with: openssl rand -hex 32
APP_JWT_SECRET=change-me-64-hex-chars
APP_JWT_EXPIRATION_MS=86400000

# Auth cookie
APP_COOKIE_SECURE=false
APP_COOKIE_SAME_SITE=lax

# CORS (comma-separated)
CORS_ALLOWED_ORIGINS=http://localhost:5173

# Rate limiting on /api/auth/*
AUTH_RATE_LIMIT_PER_MINUTE=10

# Seed admin account on startup (created only if ADMIN_EMAIL is set)
ADMIN_EMAIL=admin@securetransact.com
ADMIN_PASSWORD=change-me

# Swagger UI (enable for local dev only)
APP_SWAGGER_ENABLED=true

# ML risk sidecar (optional, graceful fallback when unreachable)
APP_ML_ENABLED=true
APP_ML_BASE_URL=http://localhost:5001
APP_ML_TIMEOUT_MS=500
